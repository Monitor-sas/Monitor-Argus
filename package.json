{
	"name": "argus",
	"type": "module",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.9.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"dev:stop": "node scripts/dev-lifecycle.mjs stop",
		"build": "node scripts/build.mjs",
		"smoke": "node scripts/smoke.mjs",
		"check": "astro check && biome check .",
		"lint": "biome check --write .",
		"format": "biome format --write .",
		"i18n:extract": "lingui extract",
		"i18n:compile": "lingui compile --namespace es",
		"predev": "npm run i18n:compile",
		"prebuild": "npm run i18n:compile",
		"astro": "astro"
	},
	"dependencies": {
		"@astrojs/vercel": "^11.0.10",
		"@lingui/cli": "^6.7.0",
		"@lingui/core": "^6.7.0",
		"astro": "^7.3.2",
		"lingui-for-astro": "^0.7.1"
	},
	"allowScripts": {
		"esbuild": true
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.12"
	}
}
