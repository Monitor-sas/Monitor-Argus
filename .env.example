# Base URL of the monitored Atlas backend (must be reachable from the deployment).
# Both service checks run through Atlas:
#   Atlas API -> GET /api/v1/system/health/atlas/
#   Hermes    -> GET /api/v1/system/health/hermes/
ATLAS_API_URL=http://localhost:8000

# Base URL of the ChirpStack network server (health + metrics probes on port 8083)
CHIRPSTACK_URL=http://localhost:8083

# Liveness URL of the Monitor Venus frontend (plain-text probe returning "healthy").
# The Venus nginx exposes /healthz for exactly this (always 200, never a 404).
VENUS_HEALTH_URL=http://localhost:3000/healthz

# Rich health URL of the Monitor Venus frontend (serves health.json: status +
# build/config metadata). Used to confirm the health metadata was baked and to
# surface version/config details. 404 here means health.json was not baked.
VENUS_HEALTH_META_URL=http://localhost:3000/health

# Admin token for the hidden /admin details view. Server-side only: NEVER prefix
# this with VITE_ (that would inline it into the client bundle). The public
# board never exposes error previews or per-check details; only visitors who
# POST this token to /api/v1/status/admin/unlock (via the hidden /admin page)
# get them. Generate a long value, e.g. `openssl rand -hex 32`.
# STATUS_DETAILS_TOKEN=

# Reserved for future persistence (required when historical monitoring lands)
# DATABASE_URL=