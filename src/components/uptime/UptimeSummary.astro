---
import { t } from "lingui-for-astro/macro";
---

<section class="summary-section" aria-label={t`Uptime history`}>
	<h2 class="section-title">{t`Uptime history`}</h2>
	<div class="empty-card">
		<p class="empty-title">{t`No historical data yet`}</p>
		<p class="empty-body">
			{t`Uptime history will appear here once monitoring data has been collected.`}
		</p>
	</div>
</section>