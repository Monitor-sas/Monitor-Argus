---
import { plural, t } from "lingui-for-astro/macro";
import { relativeTimeParts } from "../../lib/utils/status";
import type { ServiceStatusResult } from "../../types";

interface Props {
	service: ServiceStatusResult;
}

const { service } = Astro.props;

const error = service.checks.find((c) => c.error)?.error;

const STATUS_LABELS: Record<string, string> = {
	operational: t`Operational`,
	degraded: t`Degraded Performance`,
	partial_outage: t`Partial Outage`,
	major_outage: t`Major Outage`,
	unknown: t`Status Unknown`,
};

const DESCRIPTION_LABELS: Record<string, string> = {
	"Frontend application": t`Frontend application`,
	"Monitor backend API": t`Monitor backend API`,
	"Real-time service": t`Real-time service`,
	"LoRaWAN network server": t`LoRaWAN network server`,
};

function relativeTimeLabel(iso: string): string {
	const parts = relativeTimeParts(iso);
	if (parts.kind === "now") {
		return t`just now`;
	}
	switch (parts.kind) {
		case "s":
			return plural(parts.value, { one: "# second ago", other: "# seconds ago" });
		case "m":
			return plural(parts.value, { one: "# minute ago", other: "# minutes ago" });
		case "h":
			return plural(parts.value, { one: "# hour ago", other: "# hours ago" });
		case "d":
			return plural(parts.value, { one: "# day ago", other: "# days ago" });
	}
}

function responseTimeLabel(ms: number): string {
	if (ms < 1000) {
		return t`${ms} ms`;
	}
	return t`${(ms / 1000).toFixed(1)} s`;
}

function detailsLine(): string | undefined {
	const d = service.details;
	if (!d) {
		return undefined;
	}

	const parts: string[] = [];

	if (typeof d.version === "string") {
		parts.push(`v${d.version}`);
	}
	if (typeof d.platform === "string") {
		parts.push(d.platform);
	}
	if (typeof d.api_latency_ms === "number") {
		parts.push(t`API ${d.api_latency_ms}ms`);
	}
	if (typeof d.lastHeartbeatTs === "string") {
		parts.push(t`beat ${relativeTimeLabel(d.lastHeartbeatTs)}`);
	}

	return parts.length > 0 ? parts.join(" · ") : undefined;
}

const details = detailsLine();
---

<button
	type="button"
	class="service-row"
	data-open-details
	data-service-id={service.id}
	aria-haspopup="dialog"
>
	<span class="service-name">
		<span class="status-indicator" data-status={service.status} aria-hidden="true"></span>
		<span class="service-name-text">
			<span class="service-name-label">{service.name}</span>
			{service.description && (
				<span class="service-description">
					{DESCRIPTION_LABELS[service.description] ?? service.description}
				</span>
			)}
			{details && <span class="service-details">{details}</span>}
			{error && <span class="service-error">{error}</span>}
		</span>
	</span>
	<span class="service-meta">
		{service.responseTimeMs !== undefined && (
			<span class="service-time">{responseTimeLabel(service.responseTimeMs)}</span>
		)}
		<span class="status-text" data-status={service.status}>
			{STATUS_LABELS[service.status]}
		</span>
		<span class="service-chevron" aria-hidden="true">
			<svg viewBox="0 0 24 24" focusable="false">
				<path d="m9 18 6-6-6-6" />
			</svg>
		</span>
	</span>
</button>